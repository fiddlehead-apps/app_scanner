    "Sola Scanner": {
      "shouldTranslate": false
    },
    "Statement": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auszug"
          }
        }
      }
    },
    "Text recognition and Apple Intelligence run on this iPhone. No account, no server, nothing leaves the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Texterkennung und Apple Intelligence laufen auf diesem iPhone. Kein Konto, kein Server, nichts verlässt das Gerät."
          }
        }
      }
    },
    "The PDF is deleted from its folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das PDF wird aus seinem Ordner gelöscht."
          }
        }
      }
    },
    "The file is no longer in its folder. It may have been moved, renamed or deleted in the Files app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei liegt nicht mehr in ihrem Ordner. Vielleicht wurde sie in der Dateien-App verschoben, umbenannt oder gelöscht."
          }
        }
      }
    },
    "The folder can't be reached anymore. Pick it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner ist nicht mehr erreichbar. Wähl ihn noch einmal aus."
          }
        }
      }
    },
    "The list on the start screen is emptied. The PDFs stay in their folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste auf dem Startbildschirm wird geleert. Die PDFs bleiben in ihren Ordnern."
          }
        }
      }
    },
    "The pages couldn't be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten konnten nicht gelesen werden."
          }
        }
      }
    },
    "This iPhone doesn't support Apple Intelligence. Scans are saved with text recognition only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone unterstützt Apple Intelligence nicht. Scans werden nur mit Texterkennung gespeichert."
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel"
          }
        }
      }
    },
    "Turn on Apple Intelligence in the Settings app to read facts from documents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Apple Intelligence in der Einstellungen-App ein, um Angaben aus Dokumenten zu lesen."
          }
        }
      }
    },
    "Type": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Art"
          }
        }
      }
    },
    "Without Apple Intelligence, Title becomes “Scan”, Sender and Type stay empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Apple Intelligence wird Titel zu „Scan“, Absender und Art bleiben leer."
          }
        }
      }
    },
    "“%@” couldn't be reached, so the scan went into the Sola Scanner folder. Pick the folder again in the settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ war nicht erreichbar, der Scan liegt deshalb im Ordner Sola Scanner. Wähl den Ordner in den Einstellungen noch einmal aus."
          }
        }
      }
    }
  },
  "version": "1.0"
}